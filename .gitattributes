# Keep the Composer dist archive to what the plugin needs at runtime: src/ (the
# PSR-4 code plus the Resources/ build contexts), composer.json and the README.
# Everything below is development-only material.

/.github            export-ignore
/doc                export-ignore
/example            export-ignore
/tests              export-ignore
/tools              export-ignore

/.gitattributes           export-ignore
/.gitignore               export-ignore
/.php-cs-fixer.dist.php   export-ignore
/castor.composer.json     export-ignore
/castor.composer.lock     export-ignore
/castor.php               export-ignore
/phpstan-baseline.neon    export-ignore
/phpstan.neon             export-ignore
/phpunit.xml.dist         export-ignore
