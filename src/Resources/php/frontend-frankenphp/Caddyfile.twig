:80 {
	root * {{ app_root|default('/var/www') }}/public
	encode gzip
{% if mercure is defined %}
	# The Mercure hub this application serves, see MercureService. It
	# claims /.well-known/mercure* ahead of php_server. The origins are read
	# from the environment when the server starts, so a new domain does not
	# need a rebuild.
	mercure {
		publisher_jwt {env.MERCURE_JWT_SECRET}
		subscriber_jwt {env.MERCURE_JWT_SECRET}
		cors_origins {$MERCURE_CORS_ORIGINS}
		anonymous
		subscriptions
		ui
		# The history lives in the data directory of Caddy by default, which
		# belongs to root: the server runs as the user of the project.
		transport bolt {
			path /tmp/mercure.db
		}
	}
{% endif %}
{% if frankenphp_worker_file is defined %}
	php_server {
		worker {
			file {{ frankenphp_worker_file }}
{% if frankenphp_worker_num is defined %}
			num {{ frankenphp_worker_num }}
{% endif %}
{% if frankenphp_worker_watch %}
			watch
{% endif %}
		}
	}
{% else %}
	php_server
{% endif %}
	log {
		output stdout
	}
}
