{
    "name": "castor-php/docker",
    "description": "Castor plugin for docker",
    "type": "library",
    "require-dev": {
        "jolicode/castor": "^1.7",
        "phpunit/phpunit": "^13.2",
        "twig/twig": "^3.28"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Castor\\Docker\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/router.php",
            "src/tasks.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Castor\\Docker\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Joel Wurtz",
            "email": "jwurtz@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "nikic/php-parser": "^5.3"
    }
}
