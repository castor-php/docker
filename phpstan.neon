parameters:
    level: 8
    typeAliases:
        ContextData: '''
            array{
                project_name?: string,
                root_domain?: string,
                registry?: string,
                repository?: string,
                user_id?: int,
                build_args?: string[],
                twig_dockerfile_frontend?: string,
                docker_profiles?: string[],
                resolve_domains_via_host?: bool,
                router_autostart?: bool,
                build_parallel?: bool,
                worktree?: ?string,
                worktree_isolation?: bool,
                worktree_directory?: string,
                worktree_shared_home?: bool,
                worktree_start_task?: string|list<string>
            }
        '''
    paths:
        - src
        # Not the whole directory: a fixture project links back to the
        # repository, which would be walked forever.
        - tests/Unit
        - tests/Integration
        - tests/SnapshotTestCase.php
